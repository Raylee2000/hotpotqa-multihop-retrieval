# Copy to .env and fill in. .env is git-ignored. Relative paths are resolved
# against PROJECT_ROOT. Never commit real tokens or personal paths.
PROJECT_ROOT=
DATA_ROOT=data
OUTPUT_ROOT=outputs
CACHE_ROOT=.cache
MODEL_CACHE_ROOT=.cache/models
HF_HOME=.cache/huggingface
HF_TOKEN=
RANDOM_SEED=42
DEVICE=auto
MAX_WORKERS=2
ALLOW_REMOTE_MODEL_DOWNLOAD=false
# Read-only path to a pre-existing original hotpot_dev_distractor_v1.json used
# to cross-check the Hugging Face mirror. Optional: python run.py data does not need it (README.md §05).
ORIGINAL_DEV_JSON=
